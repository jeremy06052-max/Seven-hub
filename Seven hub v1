    while true do
        task.wait(0.05) -- Much faster spawning
        if State.Lagger and LP.Character and LP.Character:FindFirstChild("HumanoidRootPart") then
            for i = 1, (State.LagIntensity * 15) do
                local p = Instance.new("Part", workspace.CurrentCamera)
                p.Size = LP.Character.HumanoidRootPart.Size
                p.CFrame = LP.Character.HumanoidRootPart.CFrame * CFrame.new(0, 25, 0)
                p.CanCollide = false
                game:GetService("Debris"):AddItem(p, 0.1)
            end
        end
    end
end)

