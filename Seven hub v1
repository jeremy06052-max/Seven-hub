-- --- THEMES TAB ---
local function ApplyTheme(m, b, t)
    MainFrame.BackgroundColor3 = m
    TitleBox.BackgroundColor3 = b
    for _, btn in pairs(MainFrame:GetDescendants()) do if btn:IsA("TextButton") then btn.BackgroundColor3 = b btn.TextColor3 = t end end
end
AddButton("Red Theme", Tabs.Themes, function() ApplyTheme(Color3.fromRGB(150, 0, 0), Color3.fromRGB(0, 0, 0), Color3.new(1,1,1)) end, true)
AddButton("OLED Theme", Tabs.Themes, function() ApplyTheme(Color3.fromRGB(0, 0, 0), Color3.fromRGB(40, 40, 40), Color3.new(1,1,1)) end, true)
AddButton("Classic Theme", Tabs.Themes, function() ApplyTheme(Color3.fromRGB(80, 80, 80), Color3.fromRGB(0, 0, 0), Color3.new(1,1,1)) end, true)

