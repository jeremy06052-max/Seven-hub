local function AddButton(txt, parent, callback, isTab)
    local btn = Instance.new("TextButton", parent)
    btn.Size = UDim2.new(1, 0, 0, 32)
    btn.BackgroundColor3 = Color3.fromRGB(45, 45, 45)
    btn.TextColor3 = Color3.new(1, 1, 1)
    btn.Font = Enum.Font.GothamSemibold
    btn.Text = isTab and txt or txt .. " [OFF]"
    Round(btn, 6)
    local act = false
    btn.MouseButton1Click:Connect(function()
        if not isTab then
            act = not act
            btn.Text = txt .. (act and " [ON]" or " [OFF]")
            btn.BackgroundColor3 = act and Color3.fromRGB(100, 100, 100) or Color3.fromRGB(45, 45, 45)
        end
        callback(act)
    end)
    return btn
end

